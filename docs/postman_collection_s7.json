{
  "info": {
    "name": "DSY2207 S7 - VetCare Event Grid (VeterinariaCloud)",
    "description": "Formativa 5: BFF -> funcion generadora -> Event Grid -> funciones consumidoras -> Oracle VeterinariaCloud. Ajustar las variables de la coleccion antes de ejecutar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "bffUrl",
      "value": "http://<ip-ec2>:8080"
    },
    {
      "key": "prodUrl",
      "value": "https://func-eventos-productora-dsy2207.azurewebsites.net/api"
    },
    {
      "key": "prodKey",
      "value": "<function key de la productora>"
    },
    {
      "key": "consUrl",
      "value": "https://func-eventos-consumidora-dsy2207.azurewebsites.net/api"
    },
    {
      "key": "idUsuarioAdmin",
      "value": "1"
    },
    {
      "key": "idUsuarioConsulta",
      "value": "<id del usuario con rol CONSULTA>"
    },
    {
      "key": "idTurno",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Flujo completo via BFF",
      "item": [
        {
          "name": "1.1 Agendar cita (ADMINISTRADOR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{idUsuarioAdmin}}"
              }
            ],
            "url": "{{bffUrl}}/api/bff/eventos/turnos",
            "description": "Genera VetCare.TurnoAgendado: CITAS + recordatorio en COMUNICACIONES. Guarda idTurno.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idMascota\": 1,\n  \"idVeterinario\": 1,\n  \"fechaHora\": \"2026-10-05T10:30\",\n  \"motivo\": \"Vacuna antirrabica\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const r = pm.response.json();",
                  "pm.test('evento TurnoAgendado', () => pm.expect(r.eventType).to.eql('VetCare.TurnoAgendado'));",
                  "pm.collectionVariables.set('idTurno', r.idRecurso);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Ver citas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffUrl}}/api/bff/eventos/consultas/citas",
            "description": ""
          }
        },
        {
          "name": "1.3 Ver comunicaciones (recordatorio 24 h)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffUrl}}/api/bff/eventos/consultas/comunicaciones",
            "description": ""
          }
        },
        {
          "name": "1.4 Dispensar Meloxicam x2 (stock bajo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{idUsuarioAdmin}}"
              }
            ],
            "url": "{{bffUrl}}/api/bff/eventos/medicacion",
            "description": "Item 22 (Meloxicam) parte con stock 6 y minimo 5: queda en 4 y se genera alerta STOCK_BAJO.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idItem\": 22,\n  \"cantidad\": 2,\n  \"idMascota\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Ver inventario",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffUrl}}/api/bff/eventos/consultas/inventario",
            "description": ""
          }
        },
        {
          "name": "1.6 Ver alertas de stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffUrl}}/api/bff/eventos/consultas/alertas",
            "description": ""
          }
        },
        {
          "name": "1.7 Resultado de laboratorio listo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{idUsuarioAdmin}}"
              }
            ],
            "url": "{{bffUrl}}/api/bff/eventos/laboratorio",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idMascota\": 1,\n  \"laboratorioExterno\": \"LabVet Santiago\",\n  \"tipoExamen\": \"Hemograma completo\",\n  \"resultado\": {\n    \"hematocrito\": \"45%\",\n    \"leucocitos\": \"normal\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.8 Ver resultados de laboratorio",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffUrl}}/api/bff/eventos/consultas/resultados",
            "description": ""
          }
        },
        {
          "name": "1.9 Cancelar cita",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Usuario-Id",
                "value": "{{idUsuarioAdmin}}"
              }
            ],
            "url": "{{bffUrl}}/api/bff/eventos/turnos/{{idTurno}}/cancelar",
            "description": "Genera VetCare.TurnoCancelado: cita CANCELADA, recordatorio CANCELADO y aviso de cancelacion.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"El dueno reprograma\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.10 Ver eventos procesados (OK / RECHAZADO)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffUrl}}/api/bff/eventos/consultas/procesados",
            "description": ""
          }
        },
        {
          "name": "1.11 Ver auditoria (EVENTOS_LOG)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffUrl}}/api/bff/eventos/consultas/eventos",
            "description": ""
          }
        }
      ]
    },
    {
