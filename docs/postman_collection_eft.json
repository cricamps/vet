        {
          "name": "1.11 Eliminar rol por defecto (409)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{bffUrl}}/api/bff/roles/{{idRolPorDefecto}}",
            "description": "Regla de negocio: CONSULTA no se puede eliminar."
          },
          "event": [
