        {
          "name": "3.7 Query usuario (rol quitado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bffUrl}}/api/bff/graphql/usuarios",
            "description": "idRol debe ser null.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ usuario(id: {{idUsuarioGql}}) { idUsuario nombreUsuario idRol } }\"\n}",
