          ]
        },
        {
          "name": "1.10 Notificaciones del usuario (historial)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bffUrl}}/api/bff/usuarios/{{idUsuarioNuevo}}/notificaciones",
            "description": "BIENVENIDA, ROL_ASIGNADO, CAMBIO_ROL x2, ROL_RENOMBRADO, ROL_QUITADO."
          },
          "event": [
            {
              "listen": "test",
