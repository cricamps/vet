    {
      "name": "3. GraphQL via BFF (integracion FaaS <-> BFF)",
      "item": [
        {
          "name": "3.1 Query roles",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bffUrl}}/api/bff/graphql/roles",
            "description": "Lista de roles via BFF -> RolesGraphQL.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ roles { idRol nombreRol } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK sin errores GraphQL', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().errors).to.be.oneOf([undefined, null]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Mutation agregarUsuario SIN rol",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bffUrl}}/api/bff/graphql/usuarios",
            "description": "Requerimiento 1 por el canal GraphQL: publica UsuarioCreado (canal = GraphQL).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { agregarUsuario(nombreUsuario: \\\"Usuario GraphQL EFT\\\", profesionUsuario: \\\"QA\\\", pais: \\\"Chile\\\") { idUsuario nombreUsuario idRol } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK sin errores GraphQL', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().errors).to.be.oneOf([undefined, null]); });",
                  "pm.collectionVariables.set('idUsuarioGql', pm.response.json().data.agregarUsuario.idUsuario);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Query usuario (rol por defecto asignado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bffUrl}}/api/bff/graphql/usuarios",
            "description": "La consumidora asigno CONSULTA.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ usuario(id: {{idUsuarioGql}}) { idUsuario nombreUsuario idRol } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Event Grid entrega de forma asincrona: se espera unos segundos",
                  "setTimeout(() => {}, 5000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK sin errores GraphQL', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().errors).to.be.oneOf([undefined, null]); });",
                  "pm.test('rol por defecto', () => pm.expect(Number(pm.response.json().data.usuario.idRol)).to.eql(Number(pm.collectionVariables.get('idRolPorDefecto'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 Mutation agregarRol",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bffUrl}}/api/bff/graphql/roles",
            "description": "Publica RolCreado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { agregarRol(nombreRol: \\\"TEMPORAL GQL\\\") { idRol nombreRol } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK sin errores GraphQL', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().errors).to.be.oneOf([undefined, null]); });",
                  "pm.collectionVariables.set('idRolGql', pm.response.json().data.agregarRol.idRol);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.5 Mutation modificarUsuario (asignar rol)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bffUrl}}/api/bff/graphql/usuarios",
            "description": "Publica UsuarioModificado (cambioDeRol = true).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { modificarUsuario(id: {{idUsuarioGql}}, nombreUsuario: \\\"Usuario GraphQL EFT\\\", profesionUsuario: \\\"QA\\\", pais: \\\"Chile\\\", idRol: {{idRolGql}}) }\"\n}",
