{
  "info": {
    "name": "DSY2207 - S5S2 - REST y GraphQL (Usuarios y Roles)",
    "description": "Coleccion para la Actividad Sumativa 2 (Semana 5): ambas funciones, Usuarios y Roles, exponiendo REST y GraphQL. Reemplaza los valores de las variables baseUsuarios / baseRoles por las URLs reales de tus Function Apps desplegadas (con su ?code=<clave> si usas AuthorizationLevel distinto de anonymous).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUsuarios", "value": "https://func-usuarios-dsy2207-18514.azurewebsites.net/api" },
    { "key": "baseRoles", "value": "https://func-roles-dsy2207-14376.azurewebsites.net/api" }
  ],
  "item": [
    {
      "name": "REST - Usuarios",
      "item": [
        { "name": "Listar usuarios (GET)", "request": { "method": "GET", "url": "{{baseUsuarios}}/usuarios" } },
        { "name": "Obtener usuario por id (GET)", "request": { "method": "GET", "url": "{{baseUsuarios}}/usuarios/1" } },
        {
          "name": "Agregar usuario (POST)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUsuarios}}/usuarios",
            "body": { "mode": "raw", "raw": "{\n  \"nombreUsuario\": \"Ana Perez\",\n  \"profesionUsuario\": \"Ingeniera\",\n  \"pais\": \"Chile\",\n  \"idRol\": 1\n}" }
          }
        },
        {
          "name": "Modificar usuario (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUsuarios}}/usuarios/1",
            "body": { "mode": "raw", "raw": "{\n  \"nombreUsuario\": \"Ana Perez Actualizada\",\n  \"profesionUsuario\": \"Ingeniera Senior\",\n  \"pais\": \"Chile\",\n  \"idRol\": 1\n}" }
          }
        },
        { "name": "Eliminar usuario (DELETE)", "request": { "method": "DELETE", "url": "{{baseUsuarios}}/usuarios/1" } }
      ]
    },
    {
      "name": "GraphQL - Usuarios",
      "item": [
        {
          "name": "Query: listar usuarios",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUsuarios}}/graphql/usuarios",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query { usuarios { idUsuario nombreUsuario profesionUsuario pais idRol } }\"\n}" }
          }
        },
        {
          "name": "Query: obtener usuario por id",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUsuarios}}/graphql/usuarios",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query($id: ID!) { usuario(id: $id) { idUsuario nombreUsuario profesionUsuario pais idRol } }\",\n  \"variables\": { \"id\": \"1\" }\n}" }
          }
        },
        {
          "name": "Mutation: agregar usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUsuarios}}/graphql/usuarios",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation($n: String!, $p: String, $pa: String, $r: ID) { agregarUsuario(nombreUsuario: $n, profesionUsuario: $p, pais: $pa, idRol: $r) { idUsuario nombreUsuario } }\",\n  \"variables\": { \"n\": \"Usuario GraphQL Test\", \"p\": \"QA\", \"pa\": \"Chile\", \"r\": \"1\" }\n}" }
          }
        },
        {
          "name": "Mutation: modificar usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUsuarios}}/graphql/usuarios",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation($id: ID!, $n: String!, $p: String, $pa: String, $r: ID) { modificarUsuario(id: $id, nombreUsuario: $n, profesionUsuario: $p, pais: $pa, idRol: $r) }\",\n  \"variables\": { \"id\": \"6\", \"n\": \"Usuario GraphQL Actualizado\", \"p\": \"QA Senior\", \"pa\": \"Chile\", \"r\": \"1\" }\n}" }
          }
        },
        {
          "name": "Mutation: eliminar usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUsuarios}}/graphql/usuarios",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation($id: ID!) { eliminarUsuario(id: $id) }\",\n  \"variables\": { \"id\": \"6\" }\n}" }
          }
        }
      ]
    },
    {
      "name": "REST - Roles",
      "item": [
        { "name": "Listar roles (GET)", "request": { "method": "GET", "url": "{{baseRoles}}/roles" } },
        { "name": "Obtener rol por id (GET)", "request": { "method": "GET", "url": "{{baseRoles}}/roles/1" } }
      ]
    },
    {
      "name": "GraphQL - Roles",
      "item": [
        {
          "name": "Query: listar roles",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseRoles}}/graphql/roles",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query { roles { idRol nombreRol } }\"\n}" }
          }
        },
        {
          "name": "Mutation: agregar rol",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseRoles}}/graphql/roles",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation($n: String!) { agregarRol(nombreRol: $n) { idRol nombreRol } }\",\n  \"variables\": { \"n\": \"SOPORTE\" }\n}" }
          }
        },
        {
          "name": "Mutation: eliminar rol",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseRoles}}/graphql/roles",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation($id: ID!) { eliminarRol(id: $id) }\",\n  \"variables\": { \"id\": \"4\" }\n}" }
          }
        }
      ]
    }
  ]
}
